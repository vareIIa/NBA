# Builds de produção (npm run build:deploy, deploy e deploy:vercel): o jogo conecta na sala da Cloudflare.
# O Worker serve o jogo e a sala na mesma URL; a cópia na Vercel usa esta mesma sala (docs/24 §4.1).
# ?mp=<ws url> na página ainda tem prioridade (testes e servidor de salas local).
VITE_MP_URL=wss://garrafao.garrafao-web.workers.dev/ws
