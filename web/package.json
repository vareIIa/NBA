{
  "name": "garrafao-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "server": "node server/dev.ts",
    "build:deploy": "tsc --noEmit && vite build --config deploy/vite.config.ts",
    "deploy": "npm run build:deploy && npx wrangler@4.147.0 deploy --config deploy/wrangler.jsonc",
    "deploy:local": "npm run build:deploy && npx wrangler@4.147.0 dev --config deploy/wrangler.jsonc"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "ws": "^8.18.3"
  }
}
